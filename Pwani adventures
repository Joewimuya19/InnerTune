<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pwani Adventures</title>
  <link rel="stylesheet" href="styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
  <!-- Header Section -->
  <header>
    <div class="logo">
      <h1>Pwani Adventures</h1>
    </div>
    <nav>
      <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About Us</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#booking">Book a Trip</a></li>
      </ul>
    </nav>
  </header>

  <!-- Hero Section -->
  <section id="home" class="hero">
    <div class="hero-content">
      <h2>Explore the Beauty of the Coast</h2>
      <p>Your adventure starts here with Pwani Adventures!</p>
      <a href="#booking" class="btn">Book Now</a>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="about">
    <h2>About Us</h2>
    <p>Pwani Adventures is your gateway to unforgettable coastal experiences. From thrilling water sports to serene beach getaways, we offer tailored adventures for every traveler.</p>
  </section>

  <!-- Services Section -->
  <section id="services" class="services">
    <h2>Our Services</h2>
    <div class="service-list">
      <div class="service-item">
        <i class="fas fa-ship"></i>
        <h3>Boat Trips</h3>
        <p>Explore the ocean with our guided boat tours.</p>
      </div>
      <div class="service-item">
        <i class="fas fa-umbrella-beach"></i>
        <h3>Beach Getaways</h3>
        <p>Relax and unwind at the most beautiful beaches.</p>
      </div>
      <div class="service-item">
        <i class="fas fa-water"></i>
        <h3>Water Sports</h3>
        <p>Experience the thrill of snorkeling, diving, and more.</p>
      </div>
    </div>
  </section>

  <!-- Booking Section -->
  <section id="booking" class="booking">
    <h2>Book Your Adventure</h2>
    <form action="#" method="post">
      <label for="name">Full Name:</label>
      <input type="text" id="name" name="name" required>

      <label for="email">Email:</label>
      <input type="email" id="email" name="email" required>

      <label for="date">Trip Date:</label>
      <input type="date" id="date" name="date" required>

      <label for="service">Select Service:</label>
      <select id="service" name="service">
        <option value="boat-trip">Boat Trip</option>
        <option value="beach-getaway">Beach Getaway</option>
        <option value="water-sports">Water Sports</option>
      </select>

      <button type="submit" class="btn">Submit Booking</button>
    </form>
  </section>

  <!-- Footer Section -->
  <footer>
    <div class="social-media">
      <h3>Follow Us</h3>
      <a href="https://facebook.com/pwaniadventures" target="_blank"><i class="fab fa-facebook"></i></a>
      <a href="https://twitter.com/pwaniadventures" target="_blank"><i class="fab fa-twitter"></i></a>
      <a href="https://instagram.com/pwaniadventures" target="_blank"><i class="fab fa-instagram"></i></a>
    </div>
    <p>&copy; 2024 Pwani Adventures. All rights reserved.</p>
  </footer>
</body>
</html>
